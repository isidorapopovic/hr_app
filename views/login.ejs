<%- include('partials/header', { title: 'Login', activePage: 'login' }) %>

<section class="auth-page">
  <div class="auth-card">
    <div class="auth-head">
      <h1>Login</h1>
      <p>Sign in to access the internal HR dashboard.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert-error">
        <%= error %>
      </div>
    <% } %>

    <form method="POST" action="/login" class="auth-form">
      <div class="form-row">
        <label for="username">Username</label>
        <input
          id="username"
          name="username"
          type="text"
          required
          autocomplete="username"
        >
      </div>

      <div class="form-row">
        <label for="password">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          required
          autocomplete="current-password"
        >
      </div>

      <button type="submit" class="primary-btn">Sign in</button>
    </form>
  </div>
</section>

<%- include('partials/footer') %>