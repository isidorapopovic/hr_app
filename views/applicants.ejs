<%- include('partials/header') %>

<section class="card">
  <div class="section-head">
    <h2>Applicants</h2>
    <a class="button-link" href="/applicants/new">Add applicant</a>
  </div>

  <form method="GET" action="/applicants" class="filter-row">
    <label for="status">Filter by status</label>
    <select name="status" id="status">
      <option value="">All</option>
      <% statuses.forEach(status => { %>
        <option value="<%= status %>" <%= selectedStatus === status ? 'selected' : '' %>><%= status %></option>
      <% }) %>
    </select>
    <button type="submit">Apply</button>
    <a class="text-link" href="/applicants">Reset</a>
  </form>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Position</th>
          <th>Department</th>
          <th>Status</th>
          <th>Applied</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (!applicants.length) { %>
          <tr>
            <td colspan="6">No applicants found.</td>
          </tr>
        <% } %>

        <% applicants.forEach(row => { %>
          <tr>
            <td><%= row.full_name %></td>
            <td><%= row.position_title || '-' %></td>
            <td><%= row.department_name || '-' %></td>
            <td><%= row.application_status %></td>
            <td><%= row.applied_at %></td>
            <td><a class="text-link" href="/applicants/<%= row.applicant_id %>">View</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('partials/footer') %>