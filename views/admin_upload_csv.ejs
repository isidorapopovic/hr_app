<%- include('partials/header', { title: 'Admin CSV Upload', activePage: 'admin_upload', isLoggedIn: isLoggedIn, user: user }) %>

<section class="page-head">
  <h1>Admin CSV Upload</h1>
  <p>Import HR data in a controlled order and review results before continuing.</p>
</section>

<section class="grid-2 upload-layout">
  <article class="panel">
    <h2>Upload file</h2>

    <% if (message) { %>
      <div class="alert-success"><%= message %></div>
    <% } %>

    <% if (error) { %>
      <div class="alert-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/admin/upload-csv" enctype="multipart/form-data" class="auth-form">
      <div class="form-row">
        <label for="uploadType">Upload Type</label>
        <select id="uploadType" name="uploadType" required>
          <option value="">Select data type</option>
          <option value="departments">Departments</option>
          <option value="positions">Positions</option>
          <option value="applicants">Applicants</option>
          <option value="employees">Employees</option>
          <option value="projects">Projects</option>
          <option value="actions">Actions</option>
          <option value="combined">Combined HR CSV</option>
        </select>
      </div>

      <div class="form-row">
        <label for="csvFile">CSV File</label>
        <input id="csvFile" name="csvFile" type="file" accept=".csv" required />
      </div>

      <button type="submit" class="primary-btn">Upload CSV</button>
    </form>

    <form action="/admin/import-csv" method="POST" enctype="multipart/form-data">
    <label for="csvFile">Upload combined HR CSV</label>
    <input type="file" id="csvFile" name="csvFile" accept=".csv" required />
    <button type="submit">Upload CSV</button>
</form>
  </article>

  <article class="panel">
    <h2>Expected upload order</h2>
    <ol class="ordered-list">
      <li>Departments</li>
      <li>Positions</li>
      <li>Applicants</li>
      <li>Employees</li>
      <li>Projects</li>
      <li>Actions</li>
    </ol>
  </article>
</section>

<% if (typeof importSummary !== 'undefined' && importSummary) { %>
  <section class="stats-grid">
    <article class="stat-card">
      <span class="stat-label">Type</span>
      <div class="stat-value"><%= importSummary.uploadType %></div>
    </article>
    <article class="stat-card">
      <span class="stat-label">Total rows</span>
      <div class="stat-value"><%= importSummary.totalRows %></div>
    </article>
    <article class="stat-card">
      <span class="stat-label">Successful</span>
      <div class="stat-value"><%= importSummary.successCount %></div>
    </article>
    <article class="stat-card">
      <span class="stat-label">Failed</span>
      <div class="stat-value"><%= importSummary.failureCount %></div>
    </article>
  </section>
<% } %>

<% if (typeof detectedHeaders !== 'undefined' && detectedHeaders.length > 0) { %>
  <section class="panel">
    <h2>Detected Columns</h2>
    <div class="tag-row">
      <% detectedHeaders.forEach((header) => { %>
        <span class="badge"><%= header %></span>
      <% }) %>
    </div>
  </section>
<% } %>

<% if (typeof rowErrors !== 'undefined' && rowErrors.length > 0) { %>
  <section class="panel">
    <h2>Row Errors</h2>
    <div class="recommendation-list">
      <% rowErrors.forEach((rowError) => { %>
        <div class="recommendation-card high">
          <div class="recommendation-meta">
            <span class="badge">Row <%= rowError.rowNumber %></span>
          </div>
          <p><%= rowError.error %></p>
        </div>
      <% }) %>
    </div>
  </section>
<% } %>

<% if (typeof previewRows !== 'undefined' && previewRows.length > 0) { %>
  <section class="table-card">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <% Object.keys(previewRows[0]).forEach((key) => { %>
              <th><%= key %></th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% previewRows.forEach((row) => { %>
            <tr>
              <% Object.keys(previewRows[0]).forEach((key) => { %>
                <td><%= row[key] %></td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>

<%- include('partials/footer') %>