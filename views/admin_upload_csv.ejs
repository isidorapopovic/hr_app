<%- include('partials/header', { title: 'Admin CSV Upload', activePage: 'admin_upload', isLoggedIn: isLoggedIn, user: user }) %>

<section class="card">
  <h1>Admin CSV Upload</h1>
  <p>Import HR data in a controlled order and review results before continuing.</p>

  <% if (message) { %>
    <div class="alert success"><%= message %></div>
  <% } %>

  <% if (error) { %>
    <div class="alert error"><%= error %></div>
  <% } %>

  <form action="/admin/upload-csv" method="POST" enctype="multipart/form-data" class="stack">
    <div>
      <label for="uploadType">Upload Type</label>
      <select id="uploadType" name="uploadType" required>
        <option value="">Select data type</option>
        <option value="departments">Departments</option>
        <option value="positions">Positions</option>
        <option value="applicants">Applicants</option>
        <option value="employees">Employees</option>
        <option value="projects">Projects</option>
        <option value="actions">Actions</option>
        <option value="employee_signals">Employee Signals</option>
        <option value="combined">Combined HR CSV</option>
      </select>
    </div>

    <div>
      <label for="csvFile">CSV File</label>
      <input id="csvFile" type="file" name="csvFile" accept=".csv" required>
    </div>

    <button type="submit">Upload CSV</button>
  </form>
</section>

<section class="card">
  <h2>Expected upload order</h2>
  <ol>
    <li>Departments</li>
    <li>Positions</li>
    <li>Applicants</li>
    <li>Employees</li>
    <li>Projects</li>
    <li>Actions</li>
    <li>Employee Signals</li>
  </ol>
</section>

<section class="card">
  <h2>Employee Signals CSV format</h2>
  <p>Use employee email to assign the uploaded data to the correct employee record.</p>
  <pre>employee_email,signal_date,absent_days,sick_leave_days,overtime_hours,meeting_hours,pto_days_used,survey_sentiment,manager_feedback_score,project_intensity</pre>
</section>

<% if (importSummary) { %>
  <section class="card">
    <h2>Import Summary</h2>
    <p><strong>Type:</strong> <%= importSummary.uploadType %></p>
    <p><strong>Total rows:</strong> <%= importSummary.totalRows %></p>
    <p><strong>Successful:</strong> <%= importSummary.successCount %></p>
    <p><strong>Failed:</strong> <%= importSummary.failureCount %></p>
  </section>
<% } %>

<% if (detectedHeaders && detectedHeaders.length > 0) { %>
  <section class="card">
    <h2>Detected Columns</h2>
    <ul>
      <% detectedHeaders.forEach((header) => { %>
        <li><%= header %></li>
      <% }) %>
    </ul>
  </section>
<% } %>

<% if (rowErrors && rowErrors.length > 0) { %>
  <section class="card">
    <h2>Row Errors</h2>
    <ul>
      <% rowErrors.forEach((rowError) => { %>
        <li>Row <%= rowError.rowNumber %>: <%= rowError.error %></li>
      <% }) %>
    </ul>
  </section>
<% } %>

<%- include('partials/footer') %>