<%- include('partials/header', { title: 'Admin CSV Upload', activePage: 'admin-upload', isLoggedIn: isLoggedIn, user: user }) %>

<div class="page-card">
  <h1 class="section-title">Admin CSV Upload</h1>
  <p>Import HR data from a CSV file and review the results below.</p>

  <% if (message) { %>
    <div class="alert-success"><%= message %></div>
  <% } %>

  <% if (error) { %>
    <div class="alert-error"><%= error %></div>
  <% } %>

  <form action="/admin/upload-csv" method="POST" enctype="multipart/form-data" class="auth-form">
    <div class="form-row">
      <label for="uploadType">Upload Type</label>
      <select name="uploadType" id="uploadType" required>
        <option value="">Select data type</option>
        <option value="departments">Departments</option>
        <option value="positions">Positions</option>
        <option value="applicants">Applicants</option>
        <option value="employees">Employees</option>
        <option value="projects">Projects</option>
        <option value="actions">Actions</option>
        <option value="combined">Combined HR CSV</option>
      </select>
    </div>

    <div class="form-row">
      <label for="csvFile">CSV File</label>
      <input type="file" id="csvFile" name="csvFile" accept=".csv" required />
    </div>

    <button type="submit" class="primary-btn">Upload CSV</button>
  </form>

  <% if (typeof importSummary !== 'undefined' && importSummary) { %>
    <div class="section-space"></div>
    <h2 class="subsection-title">Import Summary</h2>
    <div class="table-wrap">
      <table class="data-table">
        <tbody>
          <tr>
            <th>Type</th>
            <td><%= importSummary.uploadType %></td>
          </tr>
          <tr>
            <th>Total rows</th>
            <td><%= importSummary.totalRows %></td>
          </tr>
          <tr>
            <th>Successful</th>
            <td><%= importSummary.successCount %></td>
          </tr>
          <tr>
            <th>Failed</th>
            <td><%= importSummary.failureCount %></td>
          </tr>
        </tbody>
      </table>
    </div>
  <% } %>

  <% if (typeof detectedHeaders !== 'undefined' && detectedHeaders.length > 0) { %>
    <div class="section-space"></div>
    <h2 class="subsection-title">Detected Columns</h2>
    <p><%= detectedHeaders.join(', ') %></p>
  <% } %>

  <% if (typeof rowErrors !== 'undefined' && rowErrors.length > 0) { %>
    <div class="section-space"></div>
    <h2 class="subsection-title">Row Errors</h2>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>CSV Row</th>
            <th>Error</th>
          </tr>
        </thead>
        <tbody>
          <% rowErrors.forEach((rowError) => { %>
            <tr>
              <td><%= rowError.rowNumber %></td>
              <td><%= rowError.error %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <% if (typeof previewRows !== 'undefined' && previewRows.length > 0) { %>
    <div class="section-space"></div>
    <h2 class="subsection-title">Preview</h2>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <% Object.keys(previewRows[0]).forEach((key) => { %>
              <th><%= key %></th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% previewRows.forEach((row) => { %>
            <tr>
              <% Object.keys(previewRows[0]).forEach((key) => { %>
                <td><%= row[key] %></td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/footer', { isLoggedIn: isLoggedIn }) %>