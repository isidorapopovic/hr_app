<%- include('partials/header', { title: 'Dashboard', activePage: 'dashboard' }) %>

<section class="dashboard-page">
  <div class="dashboard-hero">
    <div>
      <h1>Dashboard</h1>
      <p class="dashboard-subtitle">
        Overview of hiring activity and current HR status.
      </p>
    </div>
  </div>

  <section class="stats-grid dashboard-stats">
    <article class="stat-card">
      <span class="stat-label">Total applicants</span>
      <strong class="stat-value"><%= stats.totalApplicants || 0 %></strong>
    </article>

    <article class="stat-card">
      <span class="stat-label">In process</span>
      <strong class="stat-value"><%= stats.inProcess || 0 %></strong>
    </article>

    <article class="stat-card">
      <span class="stat-label">Hired</span>
      <strong class="stat-value"><%= stats.hired || 0 %></strong>
    </article>

    <article class="stat-card">
      <span class="stat-label">Active employees</span>
      <strong class="stat-value"><%= stats.activeEmployees || 0 %></strong>
    </article>

    <article class="stat-card">
      <span class="stat-label">Avg days to hire</span>
      <strong class="stat-value"><%= stats.avgDaysToHire || 0 %></strong>
    </article>

    <article class="stat-card">
      <span class="stat-label">Offer acceptance rate</span>
      <strong class="stat-value"><%= stats.offerAcceptanceRate || 0 %>%</strong>
    </article>

    <article class="stat-card">
      <span class="stat-label">Departments covered</span>
      <strong class="stat-value"><%= stats.departmentsCount || 0 %></strong>
    </article>

    <article class="stat-card">
      <span class="stat-label">Open jobs</span>
      <strong class="stat-value"><%= stats.openJobs || 0 %></strong>
    </article>
  </section>

  <div class="dashboard-sections">
    <section class="dashboard-card">
      <h2>Application Status Breakdown</h2>

      <% if (!statusCounts || statusCounts.length === 0) { %>
        <p class="empty-state">No applicant status data available.</p>
      <% } else { %>
        <div class="simple-list">
          <% statusCounts.forEach((row) => { %>
            <div class="simple-list-row">
              <span><%= row.application_status %></span>
              <strong><%= row.total %></strong>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>

    <section class="dashboard-card">
      <h2>Department Hiring Summary</h2>

      <% if (!departmentSummary || departmentSummary.length === 0) { %>
        <p class="empty-state">No department summary available.</p>
      <% } else { %>
        <div class="simple-list">
          <% departmentSummary.forEach((row) => { %>
            <div class="simple-list-row">
              <span><%= row.department_name %></span>
              <strong>
                Applicants: <%= row.applicants || 0 %> · Hires: <%= row.hires || 0 %>
              </strong>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>

    <section class="dashboard-card dashboard-card-full">
      <h2>Recent Actions</h2>

      <% if (!recentActions || recentActions.length === 0) { %>
        <p class="empty-state">No recent actions found.</p>
      <% } else { %>
        <div class="simple-list">
          <% recentActions.forEach((action) => { %>
            <div class="simple-list-row">
              <span>
                <strong><%= action.action_type || '-' %></strong>
                <% if (action.person_name) { %>
                  — <%= action.person_name %>
                <% } %>
              </span>
              <strong><%= action.action_date || '-' %></strong>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>

    <section class="dashboard-card dashboard-card-full">
      <h2>Quick links</h2>

      <div class="quick-links-grid">
        <a class="quick-link-card" href="/departments/overview">
          <h3>Departments Overview</h3>
          <p>Track department activity, workloads, projects, and staffing.</p>
        </a>

        <a class="quick-link-card" href="/employees">
          <h3>Employees</h3>
          <p>Review employee records and current staffing information.</p>
        </a>

        <a class="quick-link-card" href="/applicants">
          <h3>Applicants</h3>
          <p>See current candidates and recruitment pipeline progress.</p>
        </a>

        <a class="quick-link-card" href="/workload">
          <h3>Workload</h3>
          <p>Check workload distribution and team pressure indicators.</p>
        </a>
      </div>
    </section>
  </div>
</section>

<%- include('partials/footer') %>