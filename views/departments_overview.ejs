<%- include('partials/header', { title: 'Department Overview', activePage: 'departments', isLoggedIn: isLoggedIn }) %>

<section class="page-shell">
  <div class="insight-layout-card">
    <div class="page-heading-block">
      <h1>Department Overview</h1>
      <p>Track departments, open positions, active projects, staffing, and workload.</p>
    </div>

    <div class="stats-grid">
      <article class="stat-card">
        <span class="stat-label">Departments</span>
        <strong class="stat-value"><%= departments ? departments.length : 0 %></strong>
      </article>

      <article class="stat-card">
        <span class="stat-label">Open positions</span>
        <strong class="stat-value">
          <%= (departments || []).reduce((sum, department) => sum + Number(department.open_positions || 0), 0) %>
        </strong>
      </article>

      <article class="stat-card">
        <span class="stat-label">Projects</span>
        <strong class="stat-value">
          <%= (departments || []).reduce((sum, department) => sum + Number(department.projects_count || 0), 0) %>
        </strong>
      </article>

      <article class="stat-card">
        <span class="stat-label">Employees</span>
        <strong class="stat-value">
          <%= (departments || []).reduce((sum, department) => sum + Number(department.employees_count || 0), 0) %>
        </strong>
      </article>
    </div>

    <section class="content-section">
      <div class="section-header-row">
        <h2>Departments</h2>
      </div>

      <% if (!departments || departments.length === 0) { %>
        <div class="empty-state-card">
          <p>No departments found.</p>
        </div>
      <% } else { %>
        <div class="department-grid">
          <% departments.forEach((department) => { %>
            <article class="department-card">
              <div class="department-card-header">
                <h3><%= department.department_name %></h3>
                <a href="/departments/<%= department.department_id %>" class="table-link">Open department</a>
              </div>

              <div class="mini-stats-grid">
                <div class="mini-stat-box">
                  <span class="mini-stat-label">Open positions</span>
                  <strong class="mini-stat-value"><%= department.open_positions || 0 %></strong>
                </div>

                <div class="mini-stat-box">
                  <span class="mini-stat-label">Projects</span>
                  <strong class="mini-stat-value"><%= department.projects_count || 0 %></strong>
                </div>

                <div class="mini-stat-box">
                  <span class="mini-stat-label">Employees</span>
                  <strong class="mini-stat-value"><%= department.employees_count || 0 %></strong>
                </div>

                <div class="mini-stat-box">
                  <span class="mini-stat-label">Average workload</span>
                  <strong class="mini-stat-value"><%= department.avg_workload || 0 %>%</strong>
                </div>
              </div>

              <div class="department-extra-meta">
                <p>
                  <strong>Nearest deadline:</strong>
                  <%= department.nearest_deadline ? new Date(department.nearest_deadline).toLocaleDateString('en-GB') : '-' %>
                </p>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>
</section>

<%- include('partials/footer', { isLoggedIn: isLoggedIn }) %>