<%- include('partials/header', { title: 'Department Overview', activePage: 'departments', isLoggedIn: isLoggedIn }) %>

<section class="page-head">
  <a href="/departments" class="back-link">Back to Department Overview</a>
  <h1><%= department.department_name %></h1>
  <p class="page-subtitle">Department details, project timeline, and employees.</p>
</section>

<section class="stats-grid detail-stats">
  <div class="stat-box">
    <span class="stat-label">Open Positions</span>
    <strong class="stat-value"><%= department.open_positions ?? 0 %></strong>
  </div>

  <div class="stat-box">
    <span class="stat-label">Projects</span>
    <strong class="stat-value"><%= department.projects_count ?? 0 %></strong>
  </div>

  <div class="stat-box">
    <span class="stat-label">People Assigned</span>
    <strong class="stat-value"><%= department.people_assigned ?? 0 %></strong>
  </div>

  <div class="stat-box">
    <span class="stat-label">Average Workload</span>
    <strong class="stat-value"><%= department.avg_workload ?? 0 %>%</strong>
  </div>
</section>

<section class="content-card">
  <div class="projects-header">
    <h2>Projects</h2>
  </div>

  <div class="table-wrap">
    <table class="overview-table">
      <thead>
        <tr>
          <th>Project</th>
          <th>Started</th>
          <th>Ended</th>
          <th>Deadline</th>
          <th>Status</th>
          <th>Assigned People</th>
        </tr>
      </thead>
      <tbody>
        <% if (!projects || projects.length === 0) { %>
          <tr>
            <td colspan="6">No projects found.</td>
          </tr>
        <% } else { %>
          <% projects.forEach(project => { %>
            <tr>
              <td><%= project.project_name %></td>
              <td><%= project.start_date ? new Date(project.start_date).toLocaleDateString('en-GB') : '-' %></td>
              <td><%= project.end_date ? new Date(project.end_date).toLocaleDateString('en-GB') : '-' %></td>
              <td><%= project.deadline ? new Date(project.deadline).toLocaleDateString('en-GB') : '-' %></td>
              <td><%= project.status || 'Active' %></td>
              <td><%= project.assigned_people ?? 0 %></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<section class="content-card">
  <div class="projects-header">
    <h2>Employees</h2>
  </div>

  <div class="table-wrap">
    <table class="overview-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Workload</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (!employees || employees.length === 0) { %>
          <tr>
            <td colspan="4">No employees found.</td>
          </tr>
        <% } else { %>
          <% employees.forEach(employee => { %>
            <tr>
              <td><%= employee.full_name %></td>
              <td><%= employee.email || '-' %></td>
              <td><%= employee.workload_percent ?? 0 %>%</td>
              <td><%= employee.employment_status || '-' %></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<%- include('partials/footer', { isLoggedIn: isLoggedIn }) %>