<%- include('partials/header', { title: 'Departments Overview', activePage: 'departments-overview' }) %>


<section class="page-head">
  <a href="/" class="back-link">Back to Home</a>
  <h1>Departments Overview</h1>
  <p>Track departments, projects, assigned people, and workload.</p>
</section>

<% if (!departments || departments.length === 0) { %>
  <div class="empty-state">No departments found.</div>
<% } else { %>
  <section class="department-list">
    <% departments.forEach(department => { %>
      <article class="department-card">
        <h2>
          <a href="/departments/<%= department.department_id %>">
            <%= department.department_name %>
          </a>
        </h2>

        <div class="department-summary">
          <div class="department-metric">
            <span class="label">Nearest deadline</span>
            <span class="value"><%= department.nearest_deadline || '-' %></span>
          </div>

          <div class="department-metric">
            <span class="label">Open positions</span>
            <span class="value"><%= department.open_positions ?? 0 %></span>
          </div>

          <div class="department-metric">
            <span class="label">Projects</span>
            <span class="value"><%= department.project_count ?? 0 %></span>
          </div>

          <div class="department-metric">
            <span class="label">People assigned</span>
            <span class="value"><%= department.people_assigned ?? 0 %></span>
          </div>

          <div class="department-metric">
            <span class="label">Average workload</span>
            <span class="value"><%= department.average_workload ?? 0 %>%</span>
          </div>
        </div>

        <div style="margin-bottom: 14px;">
          <a href="/departments/<%= department.department_id %>">Open department</a>
        </div>

        <div class="table-card">
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Project</th>
                  <th>Status</th>
                  <th>Assigned People</th>
                  <th>Deadline</th>
                </tr>
              </thead>
              <tbody>
                <% if (!department.projects || department.projects.length === 0) { %>
                  <tr>
                    <td colspan="4">No projects assigned.</td>
                  </tr>
                <% } else { %>
                  <% department.projects.forEach(project => { %>
                    <tr>
                      <td><%= project.project_name %></td>
                      <td>
                        <span class="pill <%= (project.status || '').toLowerCase() === 'active' ? 'active-ok' : 'at-risk' %>">
                          <%= project.status %>
                        </span>
                      </td>
                      <td><%= project.assigned_people ?? 0 %></td>
                      <td><%= project.deadline || '-' %></td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </article>
    <% }) %>
  </section>
<% } %>

<%- include('partials/footer') %>