<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? `${title} | People Pulse` : 'People Pulse' %></title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <div class="brand">
        <a href="/home" class="brand-logo-link">
          <img src="/images/people-pulse.png" alt="People Pulse" class="brand-logo">
        </a>
      </div>

      <nav class="main-nav">
        <a href="/home" class="<%= activePage === 'home' ? 'active' : '' %>">Home</a>
        <a href="/jobs" class="<%= activePage === 'jobs' ? 'active' : '' %>">Job Postings</a>

        <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
          <a href="/dashboard" class="<%= activePage === 'dashboard' ? 'active' : '' %>">Dashboard</a>
          <a href="/departments" class="<%= activePage === 'departments' ? 'active' : '' %>">Department Overview</a>
          <a href="/employees" class="<%= activePage === 'employees' ? 'active' : '' %>">Employees</a>
          <a href="/workload" class="<%= activePage === 'workload' ? 'active' : '' %>">Workload</a>
          <a href="/organisation" class="<%= activePage === 'organisation' ? 'active' : '' %>">Organisation</a>
          <a href="/insights" class="<%= activePage === 'insights' ? 'active' : '' %>">Insights</a>
          <a href="/burnout-prediction" class="<%= activePage === 'burnout-prediction' ? 'active' : '' %>">Burnout Prediction</a>
          <a href="/admin/upload-csv" class="<%= activePage === 'admin-upload' ? 'active' : '' %>">Admin Upload</a>

          <form action="/logout" method="POST" class="logout-form">
            <button type="submit" class="logout-btn">Logout</button>
          </form>
        <% } else { %>
          <a href="/login" class="<%= activePage === 'login' ? 'active' : '' %>">HR Login</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="page-main">
    <div class="container">