<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? `${title} | HR App` : 'HR App' %></title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="page-shell">
    <header class="site-header">
      <div class="container nav-shell">
        <a href="/" class="brand-block">
          <span class="brand-kicker">HR operations platform</span>
          <span class="brand-name">HR App</span>
          <span class="brand-tagline">Recruitment, workforce visibility, and internal HR workflows</span>
        </a>

        <nav class="main-nav" aria-label="Primary navigation">
          <a href="/" class="<%= activePage === 'home' ? 'active' : '' %>">Home</a>
          <a href="/jobs" class="<%= activePage === 'jobs' ? 'active' : '' %>">Job Postings</a>

          <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
            <a href="/dashboard" class="<%= activePage === 'dashboard' ? 'active' : '' %>">Dashboard</a>
            <a href="/departments" class="<%= activePage === 'departments' ? 'active' : '' %>">Departments</a>
            <a href="/employees" class="<%= activePage === 'employees' ? 'active' : '' %>">Employees</a>
            <a href="/workload" class="<%= activePage === 'workload' ? 'active' : '' %>">Workload</a>
            <a href="/organisation" class="<%= activePage === 'organisation' ? 'active' : '' %>">Organisation</a>
            <a href="/insights" class="<%= activePage === 'insights' ? 'active' : '' %>">Insights</a>

            <form action="/logout" method="POST" class="logout-form">
              <button type="submit" class="nav-logout">Logout</button>
            </form>
          <% } else { %>
            <a href="/login" class="<%= activePage === 'login' ? 'active' : '' %>">HR Login</a>
          <% } %>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <div class="container">