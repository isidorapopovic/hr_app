<%- include('partials/header', { title: 'Employees', activePage: 'employees', isLoggedIn: isLoggedIn }) %>

<h1>Employees</h1>

<form method="GET" action="/employees">
  <label for="status">Filter by status</label>
  <select id="status" name="status">
    <option value="">All</option>
    <% statuses.forEach((status) => { %>
      <option value="<%= status %>" <%= selectedStatus === status ? 'selected' : '' %>>
        <%= status %>
      </option>
    <% }) %>
  </select>
  <button type="submit">Apply</button>
  <a href="/employees">Reset</a>
</form>

<% if (!employees || employees.length === 0) { %>
  <p>No employees found.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Position</th>
        <th>Department</th>
        <th>Reporting manager</th>
        <th>Status</th>
        <th>Hire date</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% employees.forEach((employee) => { %>
        <tr>
          <td><%= employee.full_name %></td>
          <td><%= employee.position_title || '-' %></td>
          <td><%= employee.department_name || '-' %></td>
          <td><%= employee.reporting_manager_name || '-' %></td>
          <td><%= employee.employment_status || '-' %></td>
          <td><%= employee.hire_date ? new Date(employee.hire_date).toLocaleDateString('en-GB') : '-' %></td>
          <td><a href="/employees/<%= employee.employee_id %>">View</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('partials/footer', { isLoggedIn: isLoggedIn }) %>