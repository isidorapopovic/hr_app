<%- include('partials/header', { title: employee.full_name, activePage: 'employees', isLoggedIn: isLoggedIn, user: user }) %>

<section class="page-head">
  <a href="/employees" class="back-link">Back to Employees</a>
  <h1><%= employee.full_name %></h1>
  <p>Employee profile and work information.</p>
</section>

<section class="stats-grid detail-stats">
  <div class="stat-card">
    <h3>Department</h3>
    <p><%= employee.department_name || '-' %></p>
  </div>
  <div class="stat-card">
    <h3>Position</h3>
    <p><%= employee.position_title || '-' %></p>
  </div>
  <div class="stat-card">
    <h3>Reporting Manager</h3>
    <p><%= employee.reporting_manager_name || '-' %></p>
  </div>
  <div class="stat-card">
    <h3>Status</h3>
    <p><%= employee.employment_status || '-' %></p>
  </div>
</section>

<section class="card">
  <h2>Employee Details</h2>
  <div class="two-col-grid">
    <div><strong>Full name:</strong> <%= employee.full_name %></div>
    <div><strong>Email:</strong> <%= employee.email || '-' %></div>
    <div><strong>Hire date:</strong> <%= employee.hire_date || '-' %></div>
    <div><strong>End date:</strong> <%= employee.end_date || '-' %></div>
    <div><strong>Workload:</strong> <%= employee.workload_percent || 0 %>%</div>
    <div><strong>Employment status:</strong> <%= employee.employment_status || '-' %></div>
  </div>
</section>

<section class="card">
  <h2>Burnout / Workload Signals</h2>

  <% if (!latestSignal) { %>
    <p>No signal data uploaded yet for this employee.</p>
  <% } else { %>
    <div class="stats-grid">
      <div class="stat-card">
        <h3>Latest signal date</h3>
        <p><%= latestSignal.signal_date %></p>
      </div>
      <div class="stat-card">
        <h3>Risk level</h3>
        <p><%= signalRisk.level %> (<%= signalRisk.score %>)</p>
      </div>
      <div class="stat-card">
        <h3>Overtime</h3>
        <p><%= latestSignal.overtime_hours %> h</p>
      </div>
      <div class="stat-card">
        <h3>Meeting load</h3>
        <p><%= latestSignal.meeting_hours %> h</p>
      </div>
      <div class="stat-card">
        <h3>Absenteeism</h3>
        <p><%= latestSignal.absent_days %> days</p>
      </div>
      <div class="stat-card">
        <h3>Sick leave</h3>
        <p><%= latestSignal.sick_leave_days %> days</p>
      </div>
      <div class="stat-card">
        <h3>PTO used</h3>
        <p><%= latestSignal.pto_days_used %> days</p>
      </div>
      <div class="stat-card">
        <h3>Project intensity</h3>
        <p><%= latestSignal.project_intensity ?? '-' %></p>
      </div>
    </div>

    <h3>Average values</h3>
    <div class="two-col-grid">
      <div><strong>Avg absent days:</strong> <%= signalSummary?.avg_absent_days ?? '-' %></div>
      <div><strong>Avg sick leave days:</strong> <%= signalSummary?.avg_sick_leave_days ?? '-' %></div>
      <div><strong>Avg overtime hours:</strong> <%= signalSummary?.avg_overtime_hours ?? '-' %></div>
      <div><strong>Avg meeting hours:</strong> <%= signalSummary?.avg_meeting_hours ?? '-' %></div>
      <div><strong>Avg PTO days used:</strong> <%= signalSummary?.avg_pto_days_used ?? '-' %></div>
      <div><strong>Avg survey sentiment:</strong> <%= signalSummary?.avg_survey_sentiment ?? '-' %></div>
      <div><strong>Avg manager feedback:</strong> <%= signalSummary?.avg_manager_feedback_score ?? '-' %></div>
      <div><strong>Avg project intensity:</strong> <%= signalSummary?.avg_project_intensity ?? '-' %></div>
    </div>
  <% } %>
</section>

<% if (signalHistory && signalHistory.length > 1) { %>
  <section class="card">
    <h2>Signal Trend Chart</h2>
    <div id="signal-chart" style="width:100%;max-width:900px;height:260px;"></div>
  </section>
<% } %>

<% if (signalHistory && signalHistory.length > 0) { %>
  <section class="card">
    <h2>Signal History</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Absent Days</th>
            <th>Sick Leave</th>
            <th>Overtime</th>
            <th>Meeting Hours</th>
            <th>PTO Used</th>
            <th>Survey Sentiment</th>
            <th>Manager Feedback</th>
            <th>Project Intensity</th>
          </tr>
        </thead>
        <tbody>
          <% signalHistory.slice().reverse().forEach((row) => { %>
            <tr>
              <td><%= row.signal_date %></td>
              <td><%= row.absent_days %></td>
              <td><%= row.sick_leave_days %></td>
              <td><%= row.overtime_hours %></td>
              <td><%= row.meeting_hours %></td>
              <td><%= row.pto_days_used %></td>
              <td><%= row.survey_sentiment ?? '-' %></td>
              <td><%= row.manager_feedback_score ?? '-' %></td>
              <td><%= row.project_intensity ?? '-' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>

<section class="card">
  <h2>Update reporting manager</h2>
  <form method="POST" action="/employees/<%= employee.employee_id %>/manager">
    <label for="reporting_manager_id">Reporting manager</label>
    <select id="reporting_manager_id" name="reporting_manager_id">
      <option value="">No manager</option>
      <% managers.forEach((manager) => { %>
        <option
          value="<%= manager.employee_id %>"
          <%= String(employee.reporting_manager_id || '') === String(manager.employee_id) ? 'selected' : '' %>
        >
          <%= manager.full_name %><%= manager.position_title ? ' - ' + manager.position_title : '' %>
        </option>
      <% }) %>
    </select>
    <button type="submit">Save manager</button>
  </form>
</section>

<section class="card">
  <h2>Update status</h2>
  <form method="POST" action="/employees/<%= employee.employee_id %>/status">
    <label for="employment_status">Status</label>
    <select id="employment_status" name="employment_status" required>
      <% statuses.forEach((status) => { %>
        <option value="<%= status %>" <%= employee.employment_status === status ? 'selected' : '' %>>
          <%= status %>
        </option>
      <% }) %>
    </select>

    <label for="status_notes">Notes</label>
    <textarea id="status_notes" name="notes" rows="3"></textarea>

    <button type="submit">Save status</button>
  </form>
</section>

<section class="card">
  <h2>Change position</h2>
  <form method="POST" action="/employees/<%= employee.employee_id %>/position">
    <label for="new_position_id">New position</label>
    <select id="new_position_id" name="new_position_id" required>
      <% positions.forEach((position) => { %>
        <option value="<%= position.position_id %>" <%= String(employee.position_id || '') === String(position.position_id) ? 'selected' : '' %>>
          <%= position.position_title %> - <%= position.department_name || 'Unassigned' %>
        </option>
      <% }) %>
    </select>

    <label for="position_notes">Notes</label>
    <textarea id="position_notes" name="notes" rows="3"></textarea>

    <button type="submit">Save position</button>
  </form>
</section>

<section class="card">
  <h2>Employee Timeline</h2>

  <% if (!actions || actions.length === 0) { %>
    <p>No timeline entries yet.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Action</th>
            <th>Old status</th>
            <th>New status</th>
            <th>Performed by</th>
            <th>Notes</th>
          </tr>
        </thead>
        <tbody>
          <% actions.forEach((action) => { %>
            <tr>
              <td><%= action.action_date || '-' %></td>
              <td><%= action.action_type || '-' %></td>
              <td><%= action.old_status || '-' %></td>
              <td><%= action.new_status || '-' %></td>
              <td><%= action.performed_by || '-' %></td>
              <td><%= action.notes || '-' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<% if (signalHistory && signalHistory.length > 1) { %>
<script>
  (function () {
    const data = <%- JSON.stringify(signalHistory) %>;
    const container = document.getElementById('signal-chart');
    if (!container || !data.length) return;

    const width = 860;
    const height = 240;
    const pad = 30;

    const metric = 'overtime_hours';
    const values = data.map(d => Number(d[metric] || 0));
    const maxVal = Math.max(...values, 1);

    const xStep = (width - pad * 2) / Math.max(data.length - 1, 1);
    const yScale = (height - pad * 2) / maxVal;

    const points = data.map((d, i) => {
      const x = pad + i * xStep;
      const y = height - pad - (Number(d[metric] || 0) * yScale);
      return `${x},${y}`;
    }).join(' ');

    container.innerHTML = `
      <svg viewBox="0 0 ${width} ${height}" width="100%" height="240" aria-label="Overtime trend">
        <line x1="${pad}" y1="${height - pad}" x2="${width - pad}" y2="${height - pad}" stroke="currentColor" />
        <line x1="${pad}" y1="${pad}" x2="${pad}" y2="${height - pad}" stroke="currentColor" />
        <polyline fill="none" stroke="currentColor" stroke-width="2" points="${points}" />
      </svg>
      <p style="margin-top:10px;">Showing overtime trend across uploaded signal dates.</p>
    `;
  })();
</script>
<% } %>

<%- include('partials/footer') %>