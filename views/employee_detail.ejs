<%- include('partials/header') %>

<section class="card">
  <h2><%= employee.full_name %></h2>
  <p><strong>Position:</strong> <%= employee.position_title || '-' %></p>
  <p><strong>Department:</strong> <%= employee.department_name || '-' %></p>
  <p><strong>Hire date:</strong> <%= employee.hire_date %></p>
  <p><strong>Status:</strong> <%= employee.employment_status %></p>
  <p><strong>End date:</strong> <%= employee.end_date || '-' %></p>
</section>

<section class="card">
  <h3>Update employment status</h3>
  <form method="POST" action="/employees/<%= employee.employee_id %>/status" class="form-grid">
    <label>Status</label>
    <select name="employment_status">
      <% ['active', 'on_leave', 'transferred', 'resigned', 'terminated'].forEach(status => { %>
        <option value="<%= status %>" <%= employee.employment_status === status ? 'selected' : '' %>><%= status %></option>
      <% }) %>
    </select>

    <label>Notes</label>
    <textarea name="notes" rows="3"></textarea>

    <button type="submit">Save status</button>
  </form>
</section>

<section class="card">
  <h3>Change position</h3>
  <form method="POST" action="/employees/<%= employee.employee_id %>/position" class="form-grid">
    <label>New position</label>
    <select name="new_position_id" required>
      <% positions.forEach(position => { %>
        <option value="<%= position.position_id %>" <%= String(employee.position_id) === String(position.position_id) ? 'selected' : '' %>>
          <%= position.position_title %> - <%= position.department_name || 'Unassigned' %>
        </option>
      <% }) %>
    </select>

    <label>Notes</label>
    <textarea name="notes" rows="3"></textarea>

    <button type="submit">Change position</button>
  </form>
</section>

<section class="card">
  <h3>Employee timeline</h3>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Action</th>
          <th>Old status</th>
          <th>New status</th>
          <th>Performed by</th>
          <th>Notes</th>
        </tr>
      </thead>
      <tbody>
        <% actions.forEach(action => { %>
          <tr>
            <td><%= action.action_date || '-' %></td>
            <td><%= action.action_type || '-' %></td>
            <td><%= action.old_status || '-' %></td>
            <td><%= action.new_status || '-' %></td>
            <td><%= action.performed_by || '-' %></td>
            <td><%= action.notes || '-' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('partials/footer') %>