<%- include('partials/header') %>

<section class="card small-card">
  <h2>Add Applicant</h2>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form method="POST" action="/applicants/new" class="form-grid">
    <label>Full name</label>
    <input type="text" name="full_name" value="<%= formData.full_name || '' %>" required>

    <label>Years of experience</label>
    <input type="number" step="0.1" min="0" name="years_experience" value="<%= formData.years_experience || '0' %>">

    <label>Current or last position</label>
    <input type="text" name="current_or_last_position" value="<%= formData.current_or_last_position || '' %>">

    <label>Applied position</label>
    <select name="position_id">
      <option value="">Select position</option>
      <% positions.forEach(position => { %>
        <option value="<%= position.position_id %>" <%= String(formData.position_id || '') === String(position.position_id) ? 'selected' : '' %>>
          <%= position.position_title %> - <%= position.department_name || 'Unassigned' %>
        </option>
      <% }) %>
    </select>

    <label>Status</label>
    <select name="application_status">
      <% ['applied', 'in_review', 'interview', 'offered', 'rejected', 'withdrawn', 'hired'].forEach(status => { %>
        <option value="<%= status %>" <%= (formData.application_status || 'applied') === status ? 'selected' : '' %>><%= status %></option>
      <% }) %>
    </select>

    <label>Notes</label>
    <textarea name="notes" rows="4"><%= formData.notes || '' %></textarea>

    <button type="submit">Create applicant</button>
  </form>
</section>

<%- include('partials/footer') %>