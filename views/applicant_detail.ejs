<%- include('partials/header') %>

<section class="card">
  <h2><%= applicant.full_name %></h2>
  <p><strong>Applied for:</strong> <%= applicant.position_title || '-' %></p>
  <p><strong>Department:</strong> <%= applicant.department_name || '-' %></p>
  <p><strong>Status:</strong> <%= applicant.application_status %></p>
  <p><strong>Experience:</strong> <%= applicant.years_experience %> years</p>
  <p><strong>Current/Last Position:</strong> <%= applicant.current_or_last_position || '-' %></p>
  <p><strong>Applied at:</strong> <%= applicant.applied_at %></p>
  <p><strong>Notes:</strong> <%= applicant.notes || '-' %></p>
</section>

<section class="card">
  <h3>Update status</h3>
  <form method="POST" action="/applicants/<%= applicant.applicant_id %>/status" class="form-grid">
    <label>New status</label>
    <select name="new_status">
      <% ['applied', 'in_review', 'interview', 'offered', 'rejected', 'withdrawn', 'hired'].forEach(status => { %>
        <option value="<%= status %>" <%= applicant.application_status === status ? 'selected' : '' %>><%= status %></option>
      <% }) %>
    </select>

    <label>Notes</label>
    <textarea name="notes" rows="3"></textarea>

    <button type="submit">Save status</button>
  </form>
</section>

<section class="card">
  <h3>Hire applicant</h3>
  <form method="POST" action="/applicants/<%= applicant.applicant_id %>/hire">
    <button type="submit">Hire and create employee record</button>
  </form>
</section>

<section class="card">
  <h3>Applicant timeline</h3>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Action</th>
          <th>Old status</th>
          <th>New status</th>
          <th>Performed by</th>
          <th>Notes</th>
        </tr>
      </thead>
      <tbody>
        <% actions.forEach(action => { %>
          <tr>
            <td><%= action.action_date || '-' %></td>
            <td><%= action.action_type || '-' %></td>
            <td><%= action.old_status || '-' %></td>
            <td><%= action.new_status || '-' %></td>
            <td><%= action.performed_by || '-' %></td>
            <td><%= action.notes || '-' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('partials/footer') %>