<%- include('partials/header') %>

<h2>Jobs</h2>

<div class="card">
  <% if (!jobs.length) { %>
    <p>No jobs available.</p>
  <% } %>

  <% jobs.forEach(job => { %>
    <div class="list-item">
      <h3><%= job.title %></h3>
      <p><%= job.description || 'No description' %></p>
      <a class="button-link" href="/jobs/apply/<%= job.id %>">Apply</a>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>