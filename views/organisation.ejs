<%- include('partials/header', { title: 'Organisation Chart', activePage: 'organisation', isLoggedIn: !!user }) %>

<section class="page-head">
  <h1>Organisation Chart</h1>
  <p>Overview of active employees and reporting structure.</p>
</section>

<section class="card">
  <% if (!tree || tree.length === 0) { %>
    <p>No organisation data available.</p>
  <% } else { %>
    <div class="org-tree">
      <% tree.forEach((employee) => { %>
        <div class="org-node">
          <h3><%= employee.full_name %></h3>
          <p><strong>Role:</strong> <%= employee.job_title || '-' %></p>
          <p><strong>Department:</strong> <%= employee.department_name || '-' %></p>

          <% if (employee.children && employee.children.length > 0) { %>
            <div class="org-children">
              <% employee.children.forEach((child) => { %>
                <div class="org-node child-node">
                  <h4><%= child.full_name %></h4>
                  <p><strong>Role:</strong> <%= child.job_title || '-' %></p>
                  <p><strong>Department:</strong> <%= child.department_name || '-' %></p>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>