<%- include('partials/header', { title: 'Organisation', activePage: 'organisation' }) %>

<%
function renderTree(nodes) {
  if (!nodes || nodes.length === 0) return '';
  let html = '<ul>';

  nodes.forEach((node) => {
    html += `
      <li>
        <strong>${node.full_name || 'Unknown'}</strong><br>
        ${node.job_title || 'No title'}<br>
        ${node.department_name || 'Unassigned'}
        ${renderTree(node.children || [])}
      </li>
    `;
  });

  html += '</ul>';
  return html;
}
%>

<h1>Organisation</h1>
<p>Current team structure and department breakdown.</p>

<h3>Active employees</h3>
<p><%= totalEmployees %></p>

<h3>Departments</h3>
<p><%= Object.keys(departmentGroups || {}).length %></p>

<h3>Hierarchy mode</h3>
<p><%= hasManagerData ? 'Enabled' : 'Grouped view' %></p>

<% if (hasManagerData && tree && tree.length > 0) { %>
  <h2>Organisation chart</h2>
  <%- renderTree(tree) %>
<% } else { %>
  <h2>Department structure</h2>
  <p>Manager relationships are not available yet for most employees, so employees are grouped by department.</p>

  <% Object.keys(departmentGroups || {}).sort().forEach((departmentName) => { %>
    <h3><%= departmentName %></h3>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Role</th>
        </tr>
      </thead>
      <tbody>
        <% departmentGroups[departmentName].forEach((employee) => { %>
          <tr>
            <td><%= employee.full_name %></td>
            <td><%= employee.job_title || '-' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% }) %>
<% } %>

<%- include('partials/footer') %>