<%- include('partials/header', { title: 'Home', activePage: 'home', isLoggedIn: false }) %>

<section class="hero-card">
  <div class="hero-copy">
    <span class="eyebrow">HR operations platform</span>
    <h1>Recruitment and workforce visibility in one place</h1>
    <p class="hero-text">
      Manage public job postings, support HR workflows, and build visibility across departments,
      employees, workload, and organisational structure.
    </p>

    <div class="hero-actions">
      <a href="/jobs" class="primary-link">View job postings</a>
      <a href="/login" class="secondary-link">HR login</a>
    </div>
  </div>

  <div class="hero-panel">
    <div class="mini-stat">
      <span class="mini-label">Public access</span>
      <strong>Job vacancies</strong>
    </div>
    <div class="mini-stat">
      <span class="mini-label">Internal tools</span>
      <strong>Departments, employees, insights</strong>
    </div>
    <div class="mini-stat">
      <span class="mini-label">Use case</span>
      <strong>Recruitment and HR tracking</strong>
    </div>
  </div>
</section>

<section class="panel">
  <div class="section-head">
    <div>
      <h2>Open positions</h2>
      <p>Current vacancies visible to all visitors.</p>
    </div>
    <a href="/jobs" class="text-link">See all</a>
  </div>

  <% if (!jobs || jobs.length === 0) { %>
    <div class="empty-state">
      No active job postings right now.
    </div>
  <% } else { %>
    <div class="job-grid">
      <% jobs.forEach(job => { %>
        <article class="job-card">
          <div class="job-card-top">
            <h3><%= job.position_title %></h3>
            <span class="pill <%= job.is_active ? 'active-ok' : 'at-risk' %>">
              <%= job.is_active ? 'Open' : 'Closed' %>
            </span>
          </div>

          <div class="job-meta">
            <p><strong>Department:</strong> <%= job.department_name || 'Unassigned' %></p>
            <p><strong>Level:</strong> <%= job.position_level || '-' %></p>
          </div>

          <div class="job-actions">
            <a href="/apply/<%= job.position_id %>" class="secondary-link">Apply</a>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="feature-grid">
  <article class="nav-card">
    <h2>Public recruitment</h2>
    <p>Show open roles clearly and keep the application flow simple for candidates.</p>
  </article>

  <article class="nav-card">
    <h2>Internal HR pages</h2>
    <p>Secure internal views for departments, employees, workload, and data uploads.</p>
  </article>

  <article class="nav-card">
    <h2>Scalable structure</h2>
    <p>A consistent layout that can grow into analytics, burnout monitoring, and reporting.</p>
  </article>
</section>

<%- include('partials/footer') %>