<%- include('partials/header', { title: 'Home', activePage: 'home', isLoggedIn: isLoggedIn }) %>

<section class="hero">
  <div class="hero-copy">
    <span class="eyebrow">Recruitment and HR visibility in one place</span>
    <h1>Manage hiring, people data, and workforce insight with a cleaner HR workspace.</h1>
    <p class="hero-text">
      Publish open roles, support internal HR workflows, and give teams visibility across
      departments, employees, workload, and organisational structure.
    </p>

    <div class="hero-actions">
      <a href="/jobs" class="btn btn-primary">View open positions</a>
      <a href="/login" class="btn btn-secondary">HR login</a>
    </div>

    <div class="hero-points">
      <div class="info-chip">Public access: job vacancies</div>
      <div class="info-chip">Internal tools: departments, employees, insights</div>
      <div class="info-chip">Use case: recruitment and HR tracking</div>
    </div>
  </div>

  <aside class="hero-panel">
    <div class="metric-card">
      <span class="metric-label">Visible vacancies</span>
      <strong class="metric-value"><%= jobs ? jobs.length : 0 %></strong>
    </div>
    <div class="metric-card">
      <span class="metric-label">Access type</span>
      <strong class="metric-value small">Public + Internal</strong>
    </div>
    <div class="metric-card">
      <span class="metric-label">Platform focus</span>
      <strong class="metric-value small">Hiring and workforce operations</strong>
    </div>
  </aside>
</section>

<section class="section-block">
  <div class="section-heading">
    <div>
      <span class="section-kicker">Open positions</span>
      <h2>Current vacancies</h2>
      <p>Current vacancies visible to all visitors.</p>
    </div>
    <a href="/jobs" class="text-link">See all jobs</a>
  </div>

  <% if (!jobs || jobs.length === 0) { %>
    <div class="empty-state">
      No active job postings right now.
    </div>
  <% } else { %>
    <div class="job-grid">
      <% jobs.slice(0, 6).forEach(job => { %>
        <article class="job-card">
          <div class="job-card-top">
            <span class="status-pill <%= job.is_active ? 'open' : 'closed' %>">
              <%= job.is_active ? 'Open' : 'Closed' %>
            </span>
          </div>

          <h3><%= job.position_title %></h3>

          <ul class="job-meta">
            <li>
              <span>Department</span>
              <strong><%= job.department_name || 'Unassigned' %></strong>
            </li>
            <li>
              <span>Level</span>
              <strong><%= job.position_level || '-' %></strong>
            </li>
          </ul>

          <div class="job-card-actions">
            <a href="/jobs" class="text-link">View posting</a>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="feature-band">
  <div class="feature-card">
    <h3>Recruitment workflows</h3>
    <p>Track open roles, applicants, and hiring movement across teams.</p>
  </div>
  <div class="feature-card">
    <h3>Workforce visibility</h3>
    <p>See departments, employees, and workload in one internal workspace.</p>
  </div>
  <div class="feature-card">
    <h3>Operational insight</h3>
    <p>Support reporting and structured HR decision-making across the business.</p>
  </div>
</section>

<%- include('partials/footer') %>